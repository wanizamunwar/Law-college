# The API is bundled by Vercel, never compiled in place. A stray emitted .js
# beside a .ts source shadows it in Vite's resolver and breaks `npm run dev`.
api/**/*.js
api/**/*.d.ts
api/**/*.js.map
server/**/*.js
server/**/*.d.ts
server/**/*.js.map