# Neon connection string. Find it in the Neon console under Connection Details.
# It must stay on the server — never commit it or expose it as a VITE_ variable.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-yyyy.region.aws.neon.tech/lawcollege?sslmode=require"

# Used to sign session tokens. Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-characters-long"

# Optional — overrides the account created by `npm run db:migrate`.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-password"
